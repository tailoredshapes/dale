# -----------------------------------------------------------------------------
# S3 Buckets
# -----------------------------------------------------------------------------

resource "aws_s3_bucket" "web" {
  bucket_prefix = "dale-web-"
  force_destroy = true

  tags = merge(local.common_tags, { Name = "dale-web" })
}

resource "aws_s3_bucket_public_access_block" "web" {
  bucket = aws_s3_bucket.web.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket" "consumer" {
  bucket_prefix = "dale-consumer-"
  force_destroy = true

  tags = merge(local.common_tags, { Name = "dale-consumer" })
}

resource "aws_s3_bucket_public_access_block" "consumer" {
  bucket = aws_s3_bucket.consumer.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket" "creator" {
  bucket_prefix = "dale-creator-"
  force_destroy = true

  tags = merge(local.common_tags, { Name = "dale-creator" })
}

resource "aws_s3_bucket_public_access_block" "creator" {
  bucket = aws_s3_bucket.creator.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
